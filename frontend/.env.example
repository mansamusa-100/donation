# Backend API (no trailing slash).
# Local dev: leave empty to use the Vite proxy (/api → localhost:4000) so httpOnly session cookies work.
# Production: set to your API origin, e.g. https://api.barakahfund.site
VITE_API_BASE_URL=

# Optional: support inbox for the Contact page (mailto). Default: support@barakahfund.com
# VITE_SUPPORT_EMAIL=hello@yourdomain.com

# Google OAuth client ID (from Google Auth Platform → Clients). Public identifier, safe in frontend.
# Enables the "Continue with Google" button on Login/Register. Leave unset to hide the button.
VITE_GOOGLE_CLIENT_ID=
