# Copy to .env.production on the server and fill in real values.
#   cp .env.production.example .env.production
# Never commit .env.production.

# Public hostname (DNS A/AAAA must point at this VPS). Used for HTTPS + CLIENT_ORIGIN.
DOMAIN=barakahfund.site

# Postgres (compose service `db`)
POSTGRES_USER=barakahfund
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=barakahfund

# App secrets — required in production
JWT_SECRET=change-me-at-least-32-random-chars-openssl-rand-base64-48
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=change-me-strong-owner-password
OWNER_FULL_NAME=Platform Owner
# OWNER_PASSWORD_SYNC=false

# Baked into the frontend image at build time (public Google OAuth client id)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Email (Resend preferred)
RESEND_API_KEY=
RESEND_FROM=BarakahFund <noreply@yourdomain.com>
MAIL_FROM=BarakahFund <noreply@yourdomain.com>

# Session cookies (same-origin behind Caddy — leave domain empty unless using a shared parent)
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax

# Security burst alerts (failed login / admin probe). Default on in production.
# Emails OWNER_EMAIL unless SECURITY_ALERT_TO is set. Optional Discord/Slack webhook.
# SECURITY_ALERTS_ENABLED=auto
# SECURITY_ALERT_TO=
# SECURITY_ALERT_WEBHOOK_URL=

# Payments — copy from your working local backend/.env as needed
EASYPAY_API_BASE_URL=
INTERNAL_PARTNER_API_SECRET=
INTERNAL_PARTNER_WEBHOOK_SECRET=
EASYPAY_PARTNER_BUSINESS_ID=

WAVE_API_KEY=
WAVE_API_BASE_URL=https://api.wave.com
WAVE_CHECKOUT_CURRENCY=GMD
WAVE_WEBHOOK_SECRET=
WAVE_WEBHOOK_BEARER=
