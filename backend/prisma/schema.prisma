generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  Medical
  Education
  Business
  Community
  Emergency
  Other
}

enum Currency {
  GMD
  USD
}

enum CampaignStatus {
  Draft
  PendingReview
  Active
  Closed
  Ended
  Rejected
}

enum CampaignExtensionStatus {
  Pending
  Approved
  Rejected
}

enum UserRole {
  ADMIN
  USER
}

enum WithdrawalRequestStatus {
  Pending
  Approved
  Rejected
  Paid
}

enum PayoutMethodType {
  Wallet
  Bank
  Cash
}

enum BankTransferStatus {
  Pending
  Confirmed
  Rejected
  Expired
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  fullName        String
  phoneNumber     String?
  avatarUrl       String?
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true)
  adminPanelPermissions String[] @default([])
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  campaigns       Campaign[]
  extensionRequestsSubmitted CampaignExtensionRequest[] @relation("ExtensionRequestsByUser")
  extensionRequestsReviewed  CampaignExtensionRequest[] @relation("ExtensionReviewsByAdmin")
  donations       Donation[]
  withdrawalRequests WithdrawalRequest[]
  payoutMethods      UserPayoutMethod[]
  withdrawalsMarkedPaid WithdrawalRequest[] @relation("WithdrawalPaidByAdmin")
  wavePaymentIntents WavePaymentIntent[]
  easypayPaymentIntents EasypayPaymentIntent[]
  bankTransferIntents BankTransferIntent[]
  platformTips    PlatformTip[]
  bankTransfersReviewed BankTransferIntent[] @relation("BankTransferReviewedBy")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Campaign {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  creatorName      String
  creatorAvatar    String?
  creatorId        String?
  category         Category
  shortDescription String
  fullDescription  String
  goalAmount       Int
  raisedAmount     Int            @default(0)
  donorCount       Int            @default(0)
  daysLeft         Int
  /// Inclusive campaign deadline (end of the chosen UTC calendar day).
  endsAt           DateTime
  coverImage       String
  // Extra campaign photos (same rules as cover); max 4 + cover = 5 images total.
  galleryImages    String[]       @default([])
  verificationDocumentUrl String?
  termsAcceptedAt         DateTime?
  isTrending       Boolean        @default(false)
  status           CampaignStatus @default(Active)
  /// Owner confirmed they want to close; donations stop once all funds are Paid out.
  ownerConfirmedEndAt DateTime?
  /// When the campaign reached terminal Ended status.
  endedAt          DateTime?
  donations        Donation[]
  withdrawalRequests WithdrawalRequest[]
  extensionRequests CampaignExtensionRequest[]
  wavePaymentIntents WavePaymentIntent[]
  easypayPaymentIntents EasypayPaymentIntent[]
  bankTransferIntents BankTransferIntent[]
  platformTips     PlatformTip[]
  creator          User?          @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WavePaymentIntent {
  id                  String    @id @default(cuid())
  clientReference     String    @unique
  campaignId          String
  userId              String?
  amount              Int
  platformTipAmount   Int       @default(0)
  currency            Currency  @default(GMD)
  donorName           String
  message             String?
  isAnonymous         Boolean   @default(false)
  waveSessionId       String?
  waveCheckoutStatus  String?
  wavePaymentStatus   String?
  donationId          String?   @unique
  donation            Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  platformTip         PlatformTip?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([campaignId])
}

model EasypayPaymentIntent {
  id                       String    @id @default(cuid())
  partnerExternalBookingId String    @unique
  easypayOrderId           String
  orderPublicCode          String?
  campaignId               String
  userId                   String?
  amount                   Int
  platformTipAmount        Int       @default(0)
  currency                 Currency  @default(GMD)
  donorName                String
  message                  String?
  isAnonymous              Boolean   @default(false)
  avatarUrl                String?
  lastGatewayCode          String?
  donationId               String?   @unique
  donation                 Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  campaign                 Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  platformTip              PlatformTip?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([campaignId])
  @@index([easypayOrderId])
}

model EasypayWebhookReceipt {
  id        String   @id @default(cuid())
  paymentId String
  event     String
  createdAt DateTime @default(now())

  @@unique([paymentId, event])
}

model PlatformBankAccount {
  id            String   @id @default(cuid())
  label         String?
  accountName   String
  bankName      String
  accountNumber String
  swiftCode     String
  bban          String
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bankTransfers BankTransferIntent[]
}

model BankTransferIntent {
  id                    String             @id @default(cuid())
  clientReference       String             @unique
  campaignId            String
  userId                String?
  platformBankAccountId String
  declaredAmount        Int
  confirmedAmount       Int?
  platformTipAmount     Int                @default(0)
  currency              Currency           @default(GMD)
  donorName             String
  message               String?
  isAnonymous           Boolean            @default(false)
  avatarUrl             String?
  status                BankTransferStatus @default(Pending)
  adminNote             String?
  reviewedById          String?
  reviewedAt            DateTime?
  expiresAt             DateTime
  donationId            String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  campaign              Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  platformBankAccount   PlatformBankAccount @relation(fields: [platformBankAccountId], references: [id], onDelete: Restrict)
  reviewedBy            User?              @relation("BankTransferReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  donation              Donation?          @relation(fields: [donationId], references: [id], onDelete: SetNull)
  platformTip           PlatformTip?

  @@index([status, createdAt])
  @@index([campaignId])
}

model PlatformTip {
  id                   String    @id @default(cuid())
  wavePaymentIntentId  String?   @unique
  easypayPaymentIntentId String? @unique
  bankTransferIntentId String?   @unique
  userId               String?
  donorName            String
  amount               Int
  currency             Currency  @default(GMD)
  campaignId           String?
  createdAt            DateTime    @default(now())
  wavePaymentIntent    WavePaymentIntent? @relation(fields: [wavePaymentIntentId], references: [id], onDelete: SetNull)
  easypayPaymentIntent EasypayPaymentIntent? @relation(fields: [easypayPaymentIntentId], references: [id], onDelete: SetNull)
  bankTransferIntent   BankTransferIntent?   @relation(fields: [bankTransferIntentId], references: [id], onDelete: SetNull)
  user                 User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign             Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
}

model CampaignExtensionRequest {
  id               String                  @id @default(cuid())
  campaignId       String
  requestedById    String
  /// YYYY-MM-DD from the extension form (same as campaign create).
  requestedEndDate String
  requestedEndsAt  DateTime
  reason           String?
  status           CampaignExtensionStatus @default(Pending)
  reviewedById     String?
  reviewedAt       DateTime?
  adminNote        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  campaign         Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requestedBy      User                    @relation("ExtensionRequestsByUser", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy       User?                   @relation("ExtensionReviewsByAdmin", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([status, createdAt])
}

model UserPayoutMethod {
  id        String           @id @default(cuid())
  userId    String
  type      PayoutMethodType
  label     String?
  isDefault Boolean          @default(false)
  details   Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WithdrawalRequest {
  id         String                  @id @default(cuid())
  campaignId String
  userId     String
  amount     Int
  processingFeeAmount Int @default(0)
  netAmount  Int                     @default(0)
  currency   Currency                @default(GMD)
  status     WithdrawalRequestStatus @default(Pending)
  note       String?
  adminNote  String?
  /// Snapshot from UserPayoutMethod at request time.
  payoutMethodType PayoutMethodType?
  payoutLabel      String?
  payoutDetails    Json?
  /// Admin-recorded proof when marking Paid (transfer ref, receipt note, etc.).
  payoutReference  String?
  paidAt           DateTime?
  paidByAdminId    String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidBy     User?                   @relation("WithdrawalPaidByAdmin", fields: [paidByAdminId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([userId, createdAt])
}

model Donation {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String?
  donorName   String
  amount      Int
  platformFeeAmount Int @default(0)
  currency    Currency @default(GMD)
  message     String?
  isAnonymous Boolean  @default(false)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  wavePaymentIntent WavePaymentIntent?
  easypayPaymentIntent EasypayPaymentIntent?
  bankTransferIntent BankTransferIntent?

  @@index([campaignId, createdAt])
}

model PlatformStat {
  id               String   @id @default("platform")
  totalRaised      Int
  campaignsFunded  Int
  totalDonors      Int
  communitiesHelped Int
  totalPlatformTips Int     @default(0)
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  type       String
  title      String
  detail     String?
  campaignId String?
  userId     String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
