DATABASE_URL="postgresql://postgres:admin@localhost:5432/gambiafund?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-in-production"

# Email: prefer Resend (https://resend.com). Set API key; verify a domain and use a matching RESEND_FROM.
RESEND_API_KEY=re_7538U8PW_PdK74W4HFNHqrG5R74gh3jzF
# Example after domain verification: BarakahFund <noreply@yourdomain.com>
RESEND_FROM=

# Fallback: SMTP (e.g. Mailpit localhost:1025) — used only if RESEND_API_KEY is not set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BarakahFund <onboarding@resend.dev>"

# RESEND_API_KEY=re_your_key_here
# RESEND_FROM=BarakahFund <someone@your-verified-domain.com>
# CLIENT_ORIGIN=https://your-frontend-url   # used in reset links; must match where users open the app

# -----------------------------------------------------------------------------
# Donation wallets — enable each provider by filling its section (empty = off).
# -----------------------------------------------------------------------------

# Public HTTPS base of this API (no trailing slash). Used for return URLs / webhooks when you wire them.
# APP_PUBLIC_BASE_URL=https://api.yourdomain.com

# --- Wave Business Checkout (https://docs.wave.com/checkout — key from https://business.wave.com/dev-portal)
WAVE_API_KEY=
WAVE_API_BASE_URL=https://api.wave.com
# Optional if request signing is enabled for the API key:
WAVE_SIGNING_SECRET=
# Must match your Wave wallet (often GMD in Gambia, XOF in Senegal/WAEMU)
WAVE_CHECKOUT_CURRENCY=GMD
# Webhooks: register https://<APP_PUBLIC_BASE_URL or host>/api/payments/wave/webhook
WAVE_WEBHOOK_SECRET=
WAVE_WEBHOOK_BEARER=
# Optional tuning for Wave HTTP client (defaults are fine if omitted)
# WAVE_API_TIMEOUT=10000
# WAVE_API_MAX_RETRIES=3

# --- Yonna Forex / corporate API (replace with real staging or production values when ready)
YONNA_FOREX_API_URL=
YONNA_FOREX_SECRET_KEY=
YONNA_FOREX_CLIENT_ID=
# E.g. +220 for Gambia
YONNA_FOREX_COUNTRY_CODE=+220

# --- APS Money Wallet (merchant login + customer flow — UAT vs prod base from APS)
# APS_WALLET_BASE_URL=https://sandbox-api.apswallet.gm
APS_WALLET_BASE_URL=
APS_WALLET_MOBILE=
APS_WALLET_PASSWORD=
# Sent as access_channel on login if required by APS (example: "AGENT APP")
# APS_WALLET_ACCESS_CHANNEL=
